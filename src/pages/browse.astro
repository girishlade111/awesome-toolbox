---
import Layout from '../layouts/Layout.astro';
import resourcesData from '../data/resources.json';
import { ResourceExplorer } from '../components/ui/ResourceExplorer.tsx';

const initialCategory = Astro.url.searchParams.get('category') || '';
const allTags = [...new Set(resourcesData.resources.flatMap((r) => r.tags))].sort();
---

<Layout title="Browse Resources" description="Search and filter the complete collection of community-curated AI resources.">
  <section class="dh-page-hero">
    <div class="container">
      <span class="dh-eyebrow">Explore</span>
      <h1>Browse Resources</h1>
      <p>Search {resourcesData.resources.length} community-curated agents, prompts, instructions, plugins, and workflows.</p>
    </div>
  </section>

  <section class="section container">
    <ResourceExplorer
      client:load
      resources={resourcesData.resources}
      initialCategory={initialCategory}
      allTags={allTags}
    />
  </section>
</Layout>

<style>
  .dh-page-hero {
    padding: 90px 0 30px;
    text-align: center;
    background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(99, 102, 241, 0.12), transparent);
  }
  .dh-page-hero h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 12px; }
  .dh-page-hero p { color: var(--text-secondary); max-width: 560px; margin: 0 auto; }
</style>
