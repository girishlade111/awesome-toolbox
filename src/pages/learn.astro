---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { difficulties } from '../types';
import { TutorialCard } from '../components/ui/TutorialCard.tsx';
import { Button } from '../components/ui/Button.tsx';

const tutorials = await getCollection('tutorials');

const categories = [
  { id: 'getting-started', label: 'Getting Started', icon: '🚀' },
  { id: 'tutorials', label: 'Tutorials', icon: '📚' },
  { id: 'advanced', label: 'Advanced', icon: '⚡' },
  { id: 'integration', label: 'Integrations', icon: '🔗' },
];
---

<Layout title="Learning Hub" description="Master your development tools with step-by-step tutorials and comprehensive guides from the community.">
  <section class="dh-page-hero">
    <div class="container">
      <span class="dh-eyebrow">Learn</span>
      <h1>Learning Hub</h1>
      <p>Tutorials and guides to help you get the most out of your developer tools.</p>
    </div>
  </section>

  <section class="section container">
    <div class="dh-cat-nav">
      {categories.map(cat => (
        <a href={`#${cat.id}`} class="dh-pill"><span aria-hidden>{cat.icon}</span> {cat.label}</a>
      ))}
    </div>

    {categories.map(cat => {
      const catTutorials = tutorials.filter(t => t.data.category === cat.id);
      if (catTutorials.length === 0) return null;
      return (
        <div class="dh-learn-section" id={cat.id}>
          <h2 class="dh-section-head__title">
            <span aria-hidden>{cat.icon}</span> {cat.label}
          </h2>
          <div class="dh-grid dh-grid--3">
            {catTutorials.map(tutorial => (
              <TutorialCard client:visible tutorial={tutorial.data} href={`/learn/${tutorial.id}`} />
            ))}
          </div>
        </div>
      );
    })}

    <div class="dh-cta">
      <h2>Want to contribute a tutorial?</h2>
      <p>Share your knowledge with the community by creating a tutorial.</p>
      <Button href="/submit" variant="primary">Submit a Tutorial</Button>
    </div>
  </section>
</Layout>

<style>
  .dh-cat-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 56px;
    flex-wrap: wrap;
  }
  .dh-cat-nav .dh-pill { cursor: pointer; }
  .dh-learn-section { margin-bottom: 64px; }
  .dh-section-head__title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.6rem;
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 640px) {
    .dh-grid--3 { grid-template-columns: 1fr; }
  }
</style>
