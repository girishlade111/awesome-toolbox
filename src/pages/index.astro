---
import Layout from '../layouts/Layout.astro';
import resourcesData from '../data/resources.json';
import { categories } from '../types';
import { getCollection } from 'astro:content';
import { Hero } from '../components/ui/Hero.tsx';
import { CategoryGrid } from '../components/ui/CategoryGrid.tsx';
import { ResourceGrid } from '../components/ui/ResourceGrid.tsx';
import { TutorialCard } from '../components/ui/TutorialCard.tsx';
import { Button } from '../components/ui/Button.tsx';

const allTutorials = await getCollection('tutorials');
const featuredTutorials = allTutorials.slice(0, 3);

const featured = resourcesData.resources.filter((r) => r.featured).slice(0, 9);

const authorCounts: Record<string, { count: number; url: string }> = {};
resourcesData.resources.forEach((r) => {
  if (!authorCounts[r.author]) {
    authorCounts[r.author] = { count: 0, url: r.authorUrl };
  }
  authorCounts[r.author].count++;
});
const topAuthors = Object.entries(authorCounts)
  .sort((a, b) => b[1].count - a[1].count)
  .slice(0, 6);

const counts: Record<string, number> = {};
categories.forEach((c) => {
  counts[c.id] = resourcesData.resources.filter((r) => r.category === c.id).length;
});
---

<Layout title="Home" description="Discover and share the best community-built agents, prompts, plugins, and tutorials for your favorite developer tools.">
  <Hero
    client:load
    resourceCount={resourcesData.resources.length}
    tutorialCount={allTutorials.length}
    categoryCount={categories.length}
  />

  <section class="section container">
    <div class="dh-section-head">
      <span class="dh-eyebrow">Browse</span>
      <h2>Explore by Category</h2>
      <p>Jump straight into the tooling that fits your workflow.</p>
    </div>
    <CategoryGrid client:visible categories={categories} counts={counts} />
  </section>

  <section class="section container">
    <div class="dh-section-head">
      <span class="dh-eyebrow">Hand-picked</span>
      <h2>Featured Resources</h2>
      <p>The most popular agents, prompts, and plugins in the registry.</p>
    </div>
    <ResourceGrid client:visible resources={featured} />
    <div class="dh-center">
      <Button href="/browse" variant="secondary">View all resources →</Button>
    </div>
  </section>

  <section class="section container dh-surface">
    <div class="dh-section-head">
      <span class="dh-eyebrow">Community</span>
      <h2>Top Contributors</h2>
      <p>Builders who keep the registry growing.</p>
    </div>
    <div class="dh-grid dh-grid--3">
      {topAuthors.map(([username, data]) => (
        <a href={data.url} target="_blank" rel="noopener" class="dh-card dh-card--interactive dh-author-card">
          <div class="dh-author-card__avatar">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
            </svg>
          </div>
          <div>
            <h3 class="dh-author-card__name">{username}</h3>
            <span class="dh-author-card__count">{data.count} resources</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section container">
    <div class="dh-section-head">
      <span class="dh-eyebrow">Learn</span>
      <h2>Learning Hub</h2>
      <p>Level up with curated tutorials and guides.</p>
    </div>
    <div class="dh-grid dh-grid--3">
      {featuredTutorials.map((tutorial) => (
        <TutorialCard
          client:visible
          tutorial={tutorial.data}
          href={`/learn/${tutorial.id}`}
        />
      ))}
    </div>
    <div class="dh-center">
      <Button href="/learn" variant="secondary">Explore all tutorials →</Button>
    </div>
  </section>

  <section class="section container">
    <div class="dh-cta">
      <h2>Have something to share?</h2>
      <p>Contribute your own agents, prompts, and plugins to help the community grow.</p>
      <Button href="/submit" variant="primary">Submit Your Resource</Button>
    </div>
  </section>
</Layout>
