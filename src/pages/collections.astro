---
import Layout from '../layouts/Layout.astro';
import collectionsData from '../data/collections.json';
import resourcesData from '../data/resources.json';

const { collections } = collectionsData;
const resourceMap = new Map(resourcesData.resources.map((r) => [r.id, r]));
---

<Layout title="Collections" description="Explore curated collections of tools and resources for specific use cases.">
  <section class="dh-page-hero">
    <div class="container">
      <span class="dh-eyebrow">Collections</span>
      <h1>Curated Collections</h1>
      <p>Hand-picked resources grouped by purpose to help you build better.</p>
    </div>
  </section>

  <section class="section container">
    <div class="dh-grid dh-grid--2">
      {collections.map(collection => (
        <article class="dh-card dh-collection" style={`--acc: ${collection.color}`}>
          <div class="dh-collection__head">
            <div class="dh-collection__icon">{collection.icon}</div>
            <div>
              <h3>{collection.title}</h3>
              <p>{collection.description}</p>
            </div>
          </div>

          <h4 class="dh-collection__list-title">Resources ({collection.resourceIds.length})</h4>
          <ul class="dh-collection__list">
            {collection.resourceIds.map(id => {
              const resource = resourceMap.get(id);
              if (!resource) return null;
              return (
                <li>
                  <a href={`/resource/${resource.id}`} class="dh-collection__link">
                    <span class="dh-collection__dot" />
                    {resource.title}
                  </a>
                </li>
              );
            })}
          </ul>

          <a href="/browse" class="dh-btn dh-btn--secondary dh-btn--block">Explore Collection →</a>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .dh-collection { border-top: 4px solid var(--acc); display: flex; flex-direction: column; gap: 20px; }
  .dh-collection__head { display: flex; gap: 18px; align-items: flex-start; }
  .dh-collection__icon {
    font-size: 1.8rem;
    width: 60px; height: 60px;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg-elevated);
    border-radius: var(--radius-md);
  }
  .dh-collection__head h3 { font-size: 1.25rem; margin-bottom: 6px; }
  .dh-collection__head p { font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5; }
  .dh-collection__list-title {
    font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--text-muted); margin-bottom: 10px;
  }
  .dh-collection__list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .dh-collection__link {
    display: flex; align-items: center; gap: 10px;
    font-size: 0.9375rem; color: var(--text-primary);
    transition: all 0.2s ease;
  }
  .dh-collection__link:hover { color: var(--primary); transform: translateX(4px); }
  .dh-collection__dot { width: 6px; height: 6px; background: var(--acc); border-radius: 50%; flex-shrink: 0; }
  @media (max-width: 640px) { .dh-grid--2 { grid-template-columns: 1fr; } }
</style>
